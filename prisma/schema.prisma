// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// ENUMS
// ========================================

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SCHEDULED
  PRINTING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PrintStatus {
  SCHEDULED
  PRINTING
  COMPLETED
  FAILED
}

enum MaterialType {
  PLA
  ABS
  PETG
  TPU
  NYLON
  RESIN
  WOOD_FILLED
  METAL_FILLED
}

enum ProductType {
  THREE_D_PRINT
  PAPER_CRAFT
}

enum PaperType {
  CARDSTOCK
  CONSTRUCTION_PAPER
  KRAFT_PAPER
  GLITTER_CARDSTOCK
  VELLUM
  VINYL
  FOAM_SHEET
  CORRUGATED_CARDBOARD
}

enum CuttingMachine {
  CRICUT_MAKER
  CRICUT_EXPLORE
  SILHOUETTE_CAMEO
  BROTHER_SCAN_N_CUT
  GENERIC_PLOTTER
}

enum OccasionType {
  BIRTHDAY
  WEDDING
  GRADUATION
  CONFERENCE
  TRADE_SHOW
  CORPORATE_EVENT
  BAPTISM
  COMMUNION
  CONFIRMATION
  RELIGIOUS_CELEBRATION
  ANNIVERSARY
  BABY_SHOWER
  PROMOTIONAL_GADGET
  SEASONAL_HOLIDAY
  CUSTOM_GIFT
  SCHOOL_EVENT
  SPORTS_EVENT
  OTHER
}

// ========================================
// MODELS
// ========================================

model User {
  id            String          @id @default(uuid())
  name          String?
  email         String          @unique
  password      String?
  role          Role            @default(USER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  accounts       Account[]
  sessions       Session[]
  models         Model3D[]
  customizations Customization[]
  orders         Order[]
  notifications  Notification[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Model3D {
  id                  String           @id @default(uuid())
  name                String
  description         String           @db.Text
  productType         ProductType      @default(THREE_D_PRINT)
  occasions           OccasionType[]

  // 3D Print specific fields
  fileUrl             String?
  availableMaterials  MaterialType[]

  // Paper craft specific fields
  paperTypes          PaperType[]
  compatibleMachines  CuttingMachine[]

  // Common fields
  previewImageUrl     String?
  maxColors           Int              @default(1)
  basePrice           Decimal          @default(0.00) @db.Decimal(10, 2)
  isActive            Boolean          @default(true)
  createdById         String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // Relations
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  customizations Customization[]

  @@map("models_3d")
}

model Customization {
  id            String   @id @default(uuid())
  modelId       String
  userId        String
  parameters    Json // { color: string, text: string, dimensions: {x, y, z}, etc. }
  logoFileUrl   String?
  aiSuggestion  String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  model      Model3D     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("customizations")
}

model Order {
  id           String      @id @default(uuid())
  userId       String
  status       OrderStatus @default(PENDING_PAYMENT)
  shippingInfo Json // { name, address, city, zipCode, country, phone, email }
  totalAmount  Decimal     @db.Decimal(10, 2)
  stripePaymentIntentId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   OrderItem[]
  invoice Invoice?

  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  customizationId String
  quantity        Int      @default(1)
  unitPrice       Decimal  @db.Decimal(10, 2)
  subtotal        Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  // Relations
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customization Customization @relation(fields: [customizationId], references: [id], onDelete: Cascade)
  printJobs     PrintJob[]

  @@map("order_items")
}

model PrintPartner {
  id                 String         @id @default(uuid())
  name               String
  email              String         @unique
  location           String
  supportedMaterials MaterialType[]
  maxColors          Int            @default(1)
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  printJobs PrintJob[]

  @@map("print_partners")
}

model PrintJob {
  id                        String      @id @default(uuid())
  orderItemId               String
  partnerId                 String?
  status                    PrintStatus @default(SCHEDULED)
  estimatedPrintTimeMinutes Int?
  assignedColors            Json? // Array of colors used
  notes                     String?     @db.Text
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  // Relations
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  partner   PrintPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@map("print_jobs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // "order_status", "print_job", "system"
  relatedId String?  // orderId or jobId
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ApiClient {
  id        String   @id @default(uuid())
  name      String
  apiKey    String   @unique
  email     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("api_clients")
}

model Invoice {
  id             String   @id @default(uuid())
  orderId        String   @unique
  invoiceNumber  String   @unique
  billingName    String
  billingAddress Json     // { address, city, zip, country }
  taxId          String?
  amount         Decimal  @db.Decimal(10, 2)
  currency       String   @default("USD")
  issuedAt       DateTime @default(now())
  pdfUrl         String?

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}
